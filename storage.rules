rules_version = '2';

// انسخ هذا الملف كاملاً إلى Firebase Console → Storage → Rules، ثم اضغط Publish.
// بدونها لن تعمل رفع صور المنتجات وشعارات الماركات من لوحة الإدارة.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // نفس منطق firestore.rules: قراءة عامة (لعرض الصور في الموقع)، وكتابة عامة لأن
      // الموقع بلا خادم خلفي وبلا تسجيل دخول. راجع التحذير الأمني في README.
      allow read: if true;
      allow write: if true;
    }
  }
}
