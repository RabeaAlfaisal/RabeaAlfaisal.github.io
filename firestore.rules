rules_version = '2';

// انسخ هذا الملف كاملاً إلى Firebase Console → Firestore Database → Rules، ثم اضغط Publish.
// بدون هذه القواعد يبقى الوضع الافتراضي "allow read, write: if false" ولن يعمل الموقع ولا لوحة الإدارة.
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      // الكتالوج العام يحتاج قراءة مفتوحة لأي زائر
      allow read: if true;

      // تحذير: الكتابة مفتوحة للجميع لأن الموقع بلا خادم خلفي وبلا تسجيل دخول (Firebase Auth).
      // أي شخص يعرف رابط Firestore الخاص بالمشروع (وهو ظاهر في كود الواجهة أصلاً) يمكنه الكتابة مباشرة،
      // ليس فقط عبر صفحة admin/. هذا مقصود حسب اختيار "بدون Auth" لتبسيط الإدارة، وليس أماناً حقيقياً.
      // لحماية فعلية: فعّل Firebase Authentication وغيّر السطر التالي إلى: allow write: if request.auth != null;
      allow write: if true;
    }
  }
}
